# Coolify service -------------------------------------------------------------

# Laravel encryption key. Never rotate it: Coolify encrypts every registered
# server's SSH private key with it.
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_URL=

# Root account, created on first boot only.
# Email is validated with email:rfc,dns - the domain must resolve.
# Password needs mixed case, a digit, a symbol, and it is checked against
# HaveIBeenPwned. A value that fails silently skips account creation.
ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

# Postgres. On Railway: ${{Postgres.PGHOST}} etc.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis. On Railway: ${{Redis.REDISHOST}} etc.
# Do not also set REDIS_URL; Laravel prefers it and would ignore these.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Soketi credentials. Must match the realtime service exactly.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Where the backend pushes events. Not the browser-facing values.
PUSHER_BACKEND_HOST=coolify-realtime.railway.internal
PUSHER_BACKEND_PORT=6001
PUSHER_SCHEME=http

# Upstream for the nginx websocket locations.
REALTIME_HOST=coolify-realtime.railway.internal

APP_ENV=production
APP_DEBUG=false
APP_NAME=Coolify
# PHP_MEMORY_LIMIT=512M

# Not listed on purpose:
#   PUSHER_HOST / PUSHER_PORT / TERMINAL_* - override the browser-side websocket
#     URL. Unset, the frontend falls back to this host with no port, which is
#     exactly what nginx proxies. Setting them breaks the websockets.
#   SELF_HOSTED - false puts Coolify in cloud mode, which demands a verified
#     email RootUserSeeder never sets. You would be locked out.
#   AUTOUPDATE - defaulted to false in coolify/Dockerfile; the updater cannot
#     work on Railway.
#   NIGHTWATCH_ENABLED - nothing reads it; the s6 service gates on a .env file
#     this container does not have.

# Realtime service ------------------------------------------------------------

SOKETI_DEFAULT_APP_ID=
SOKETI_DEFAULT_APP_KEY=
SOKETI_DEFAULT_APP_SECRET=
# APP_NAME=Coolify
# SOKETI_DEBUG=false

# SOKETI_HOST is "::" in the Dockerfile - Railway's private network is IPv6.
